{
    "name": "job-board-portal",
    "private": true,
    "type": "module",
    "workspaces": [
        "client"
    ],
    "scripts": {
        "dev": "concurrently -n server,client -c blue,green \"npm run server\" \"npm run client\"",
        "server": "nodemon server/index.js",
        "client": "npm --workspace client run dev",
        "build": "npm --workspace client run build",
        "seed": "node server/seedDemo.js",
        "seed:enhanced": "node server/seedEnhanced.js"
    },
    "dependencies": {
        "bcryptjs": "^2.4.3",
        "cookie-parser": "^1.4.6",
        "cors": "^2.8.1",
        "dotenv": "^16.4.0",
        "express": "^4.21.2",
        "jsonwebtoken": "^9.0.2",
        "mongoose": "^8.17.1",
        "socket.io": "^4.8.3",
        "socket.io-client": "^4.8.3"
    },
    "devDependencies": {
        "concurrently": "^9.0.1",
        "nodemon": "^3.1.0"
    }
}
